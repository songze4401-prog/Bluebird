{
  "version": 1,
  "note": "后端能力与前端消费者的登记册。scripts/verify-api-capabilities.js 会核对：路由是否都登记、登记的路由是否真的存在、标 ui 的能力是否真有前端消费者、标 api-only 的能力是否确实没有前端消费者。api-only 的能力不会被下线——它们是对外可用的 API，只是本仓库没有做界面。",
  "routers": [
    { "file": "server/index.js", "mount": "", "mountExpr": "app.get('/'" },
    { "file": "server/agents/routes.js", "mount": "", "mountExpr": "app.use(createAgentRouter" },
    { "file": "server/retrieval/routes.js", "mount": "/retrieval", "mountExpr": "app.use('/retrieval'" },
    { "file": "server/monitoring/routes.js", "mount": "/monitoring", "mountExpr": "app.use('/monitoring'" }
  ],
  "families": [
    {
      "id": "root-meta",
      "title": "服务元信息",
      "prefix": "/",
      "exact": true,
      "capabilities": [
        {
          "name": "GET / 返回版本与状态",
          "probe": "'/'",
          "ui": false,
          "consumers": [],
          "note": "只读探针，供部署方与监控使用；应用本身不调用。"
        }
      ]
    },
    {
      "id": "sessions",
      "title": "会话",
      "prefix": "/sessions",
      "capabilities": [
        {
          "name": "会话列表",
          "probe": "API_PATHS.sessions",
          "ui": true,
          "consumers": ["hooks/useSessionList.ts"]
        },
        {
          "name": "单会话读取 / 删除",
          "probe": "API_PATHS.session(",
          "ui": true,
          "consumers": ["hooks/useSessionActions.ts"]
        }
      ]
    },
    {
      "id": "history",
      "title": "聊天历史",
      "prefix": "/history",
      "capabilities": [
        {
          "name": "历史分页读取 / 清空 / 撤回",
          "probe": "API_PATHS.history",
          "ui": true,
          "consumers": ["hooks/useChatSession.ts"]
        }
      ]
    },
    {
      "id": "uploads",
      "title": "附件上传",
      "prefix": "/uploads",
      "capabilities": [
        {
          "name": "图片上传 / 读取 / 删除",
          "probe": "API_PATHS.uploads",
          "ui": true,
          "consumers": ["lib/uploads.ts"],
          "note": "选图 → 上传的上层流程在 hooks/useAttachments.ts，它调用 lib/uploads.ts 的 uploadImage。"
        }
      ]
    },
    {
      "id": "stickers",
      "title": "表情包库（旧接口）",
      "prefix": "/stickers",
      "capabilities": [
        {
          "name": "GET /stickers 旧表情包列表",
          "probe": "/stickers",
          "ui": false,
          "consumers": [],
          "note": "前端改用 /sticker-repo；此接口保留给旧客户端，无界面消费者。"
        }
      ]
    },
    {
      "id": "sticker-repo",
      "title": "表情包仓库",
      "prefix": "/sticker-repo",
      "capabilities": [
        {
          "name": "仓库列表 / 上传 / 收藏 / 搜索 / 删除",
          "probe": "API_PATHS.stickerRepo",
          "ui": true,
          "consumers": ["lib/uploads.ts"]
        }
      ]
    },
    {
      "id": "model-providers",
      "title": "模型服务商",
      "prefix": "/model-providers",
      "capabilities": [
        {
          "name": "列表 / 详情 / 新建 / 编辑 / 删除 / 连通性测试 / 默认模型",
          "probe": "API_PATHS.modelProviders",
          "ui": true,
          "consumers": [
            "components/ModelScreen.tsx",
            "hooks/useModelSelection.ts",
            "components/MemoryBotScreen.tsx"
          ]
        },
        {
          "name": "启停单个服务商 POST /model-providers/:id/enabled",
          "probe": "API_PATHS.modelProviderEnabled",
          "ui": false,
          "consumers": [],
          "note": "接口可用但界面没有开关；启停只能通过接口调用。"
        }
      ]
    },
    {
      "id": "memory",
      "title": "记忆",
      "prefix": "/memory",
      "capabilities": [
        {
          "name": "记忆读取 / 审计视图 / 删除 / 按会话清理 / 确认 / 驳回 / 归档 / 写入尝试",
          "probe": "API_PATHS.memory",
          "ui": true,
          "consumers": ["components/MemoryCenterScreen.tsx"]
        },
        {
          "name": "待确认候选 GET /memory/pending",
          "probe": "API_PATHS.memoryPending",
          "ui": false,
          "consumers": [],
          "note": "待确认候选有界面入口（Memory Center 的确认动作走 /memory/confirm），但没有独立的待确认列表界面。"
        }
      ]
    },
    {
      "id": "profile",
      "title": "画像与反馈",
      "prefix": "/profile",
      "capabilities": [
        {
          "name": "画像读取 GET /profile",
          "probe": "API_PATHS.profile",
          "ui": true,
          "consumers": ["components/MemoryCenterScreen.tsx"],
          "note": "P6 Memory Center 画像页；从 memory.json 派生，includeInactive 可查看历史。"
        },
        {
          "name": "画像反馈 POST /profile/feedback",
          "probe": "API_PATHS.profileFeedback",
          "ui": true,
          "consumers": ["components/MemoryCenterScreen.tsx"],
          "note": "Memory Center 画像页的确认/否认/纠正；feedbackId 幂等，结果写审计。"
        }
      ]
    },
    {
      "id": "emotion",
      "title": "情绪状态",
      "prefix": "/emotion",
      "capabilities": [
        {
          "name": "读取情绪",
          "probe": "API_PATHS.emotion",
          "ui": true,
          "consumers": ["hooks/useChatSession.ts"]
        }
      ]
    },
    {
      "id": "presence",
      "title": "在线状态",
      "prefix": "/presence",
      "capabilities": [
        {
          "name": "上报 / 读取快照",
          "probe": "API_PATHS.presenceReport",
          "ui": true,
          "consumers": ["lib/presence.ts"]
        }
      ]
    },
    {
      "id": "persona",
      "title": "人格设定",
      "prefix": "/persona",
      "capabilities": [
        {
          "name": "读取 / 保存人格",
          "probe": "API_PATHS.persona",
          "ui": true,
          "consumers": ["components/ControlPanelScreen.tsx"]
        }
      ]
    },
    {
      "id": "agent-policy",
      "title": "Agent 策略",
      "prefix": "/agent-policy",
      "capabilities": [
        {
          "name": "读取 / 保存 / 重置策略",
          "probe": "API_PATHS.agentPolicy",
          "ui": true,
          "consumers": ["components/ControlPanelScreen.tsx", "components/AgentToolsScreen.tsx"]
        }
      ]
    },
    {
      "id": "chat",
      "title": "对话",
      "prefix": "/chat",
      "capabilities": [
        {
          "name": "非流式 / 流式对话",
          "probe": "API_PATHS.chat",
          "ui": true,
          "consumers": ["hooks/useChatSession.ts", "lib/stream.ts"]
        }
      ]
    },
    {
      "id": "agents",
      "title": "Memory Bot",
      "prefix": "/agents",
      "capabilities": [
        {
          "name": "Bot 列表",
          "probe": "API_PATHS.agents",
          "ui": true,
          "consumers": ["components/AgentTeamScreen.tsx"]
        },
        {
          "name": "Bot 配置 / 凭证 / 会话 / 事件 / 审批 / 对话",
          "probe": "API_PATHS.agentConfig(",
          "ui": true,
          "consumers": ["components/MemoryBotScreen.tsx"]
        },
        {
          "name": "Bot 权限查看 GET /agents/:botId/permissions",
          "probe": "API_PATHS.agentPermissions",
          "ui": false,
          "consumers": [],
          "note": "权限模型目前是单用户 local-owner，界面不展示权限详情。"
        }
      ]
    },
    {
      "id": "agent-approvals",
      "title": "审批",
      "prefix": "/agent-approvals",
      "capabilities": [
        {
          "name": "审批通过 / 驳回 / 执行",
          "probe": "API_PATHS.agentApprovalApprove",
          "ui": true,
          "consumers": ["components/MemoryBotScreen.tsx"]
        }
      ]
    },
    {
      "id": "agent-tasks",
      "title": "Agent 任务",
      "prefix": "/agent-tasks",
      "capabilities": [
        {
          "name": "任务列表 / 详情 / 创建",
          "probe": "API_PATHS.agentTasks",
          "ui": true,
          "consumers": ["components/TasksPanel.tsx", "components/MemoryBotScreen.tsx"]
        },
        {
          "name": "取消任务 POST /agent-tasks/:taskId/cancel",
          "probe": "API_PATHS.agentTaskCancel",
          "ui": false,
          "consumers": [],
          "note": "取消能力在服务端可用，任务页只读展示状态，没有取消按钮。"
        }
      ]
    },
    {
      "id": "agent-results",
      "title": "委派结果流",
      "prefix": "/agent-results",
      "capabilities": [
        {
          "name": "结果事件流 GET /agent-results/stream",
          "probe": "API_PATHS.agentResultsStream",
          "ui": true,
          "consumers": ["lib/agent-results-stream.ts"]
        }
      ]
    },
    {
      "id": "retrieval",
      "title": "统一检索",
      "prefix": "/retrieval",
      "capabilities": [
        {
          "name": "索引状态 / 来源 / 检索 / 摄取 / 同步 / 重建 / 向量回填",
          "probe": "/retrieval",
          "ui": false,
          "consumers": [],
          "note": "统一检索由 Agent 的 knowledge_search 工具在后台使用，没有独立的检索界面。"
        }
      ]
    },
    {
      "id": "monitoring",
      "title": "系统监控",
      "prefix": "/monitoring",
      "capabilities": [
        {
          "name": "总览 / Trace / 事件 / 审计 / 工具 / 模型 / 告警 / 健康",
          "probe": "API_PATHS.monitoringOverview",
          "ui": true,
          "consumers": ["components/MonitoringScreen.tsx"]
        },
        {
          "name": "监控元信息 GET /monitoring/meta",
          "probe": "API_PATHS.monitoringMeta",
          "ui": false,
          "consumers": [],
          "note": "元信息只供排查使用，监控页不展示。"
        },
        {
          "name": "指标序列 GET /monitoring/metrics",
          "probe": "API_PATHS.monitoringMetrics",
          "ui": false,
          "consumers": [],
          "note": "指标接口可用，监控页只读总览与 Trace，没有指标曲线。"
        }
      ]
    }
  ]
}
