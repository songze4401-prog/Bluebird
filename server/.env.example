# Bluebird 服务端配置
# 复制本文件为 server/.env 并填写后，在 server/ 目录下启动：node index.js

# DeepSeek 模型 API Key（必填，否则 /chat 无法对话）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 客户端访问令牌（必填，前后端需一致；用于保护聊天记录与长期记忆）
BLUEBIRD_API_TOKEN=change-me-to-a-long-random-string

# 浏览器跨域来源白名单（可选，逗号分隔，精确匹配 scheme+host+port）。
# 不配置时只允许本地 Expo Web 开发地址；生产部署必须显式配置。
# BLUEBIRD_CORS_ORIGINS=https://bluebird.example.com

# 服务端口（可选，默认 3000）
PORT=3000

# 长期记忆开关（可选，默认开启）
MEMORY_ENABLED=true

# 记忆写入证据策略（可选，默认 compat；修改后需重启后端）
# compat = 保持既有行为；strict = 单次长期偏好先成为待确认候选，
# 只有显式持久意图（记住/以后/长期等）或第二次独立表达才晋升为 active。
# 两种模式都会把模型推断/模糊行为模式停为 pending，并写入 provenance/evidence。
# BLUEBIRD_MEMORY_EVIDENCE_POLICY=compat

# 可信用户身份（可选，默认 local-owner）。长期记忆的读/写作用域按它划分，
# 只从服务端配置读取，绝不接受客户端传入的 userId。
# 注意：改了值之后，已落盘为旧 userId 的记忆与会话会被判为"他人数据"而不再可见
# （记忆查不到、/sessions 变空、/chat 回 404）。单用户部署请固定一个值再上线。
# BLUEBIRD_USER_ID=local-owner

# Agent 工具调用开关（可选，默认关闭；只有精确值 1 才开启）
# 允许值：1=开启；0/未设置/其他值=关闭
# 开启后仍需同时满足：所选模型声明 capabilities.tools === true，且本次请求不带图片。
# 工具调用会增加模型轮数、延迟与费用（默认最多 3 轮；BLUEBIRD_AGENT_MAX_ROUNDS 可在 2-5 间调整，硬上限 5）。
# 修改本项后必须重启后端：dotenv 只在进程启动时读取 .env，运行中的进程不会自动重载。
BLUEBIRD_AGENT_TOOLS=0

# 单条回复硬上限（码点，默认 400）：一条回复默认只落一条消息，
# 只有超过该值才按段落/换行/句末标点分片；可用此变量覆盖默认值。
# BLUEBIRD_REPLY_MAX_CHARS=400

# Memory Bot 凭证库主密钥（可选；64 位十六进制）。
# 未设置时会自动生成 server/data/agents/agent-vault.key（尽力 chmod 0600）。
# 生产环境建议通过密钥管理注入，且不要与任何 Provider Key 相同。
# BLUEBIRD_AGENT_VAULT_KEY=

# Memory Bot 任务队列并发（默认 2，范围 1-4）；服务重启会自动恢复中断任务：
# BLUEBIRD_AGENT_TASK_CONCURRENCY=2
# 单个任务最大尝试次数（默认 1；有副作用的写入任务不建议依赖自动重试）：
# BLUEBIRD_AGENT_TASK_MAX_ATTEMPTS=1

# ---- 统一检索（可选） ----
# 关闭统一检索（含 /retrieval API、knowledge_search、外部知识上下文）：
# BLUEBIRD_RETRIEVAL=0
# 关闭外部知识注入，仅保留 API/Agent 检索：
# BLUEBIRD_RETRIEVAL_CONTEXT=0
# 文档/代码摄取允许的根目录（多个用系统路径分隔符；不配置则文件摄取拒绝）：
# BLUEBIRD_RETRIEVAL_ROOTS=/absolute/path/to/docs:/absolute/path/to/repo
# 网页抓取默认拒绝环回/私网地址；仅本地测试 fixture 才建议开启：
# BLUEBIRD_RETRIEVAL_ALLOW_PRIVATE_URL=0
# 可选 Embedding Provider（OpenAI-compatible /embeddings）；未配置时向量通道
# 显式 unavailable，词法/精确检索照常工作：
# BLUEBIRD_RETRIEVAL_EMBEDDING_PROVIDER=openai-compatible
# BLUEBIRD_RETRIEVAL_EMBEDDING_BASE_URL=https://your-embedding-host/v1
# BLUEBIRD_RETRIEVAL_EMBEDDING_MODEL=your-embedding-model
# BLUEBIRD_RETRIEVAL_EMBEDDING_DIMENSION=1536
# BLUEBIRD_RETRIEVAL_EMBEDDING_API_KEY=sk-your-embedding-key
# BLUEBIRD_RETRIEVAL_EMBEDDING_VERSION=v1
# 检索型模型前缀（E5 系列需要；空白有语义，用引号保留尾随空格）：
# BLUEBIRD_RETRIEVAL_EMBEDDING_QUERY_PREFIX="query: "
# BLUEBIRD_RETRIEVAL_EMBEDDING_DOCUMENT_PREFIX="passage: "
# 批量大小 / 超时 / 内存缓存条数（默认 16 / 8000ms / 2000）：
# BLUEBIRD_RETRIEVAL_EMBEDDING_BATCH=16
# BLUEBIRD_RETRIEVAL_EMBEDDING_TIMEOUT_MS=8000
# BLUEBIRD_RETRIEVAL_EMBEDDING_CACHE_MAX=2000
# 供应商预设（只写 provider + API_KEY 即可，BASE_URL/MODEL/DIMENSION 取预设；
# 显式设置永远优先，方便换自建或代理端点）：
#   dashscope   = 阿里云百炼 text-embedding-v3（1024 维，中文强，约 $0.07/百万 token）
#   siliconflow = BAAI/bge-m3（1024 维，多语言/中文好，约 $0.01/百万 token）
#   openai      = text-embedding-3-small（1536 维，约 $0.02/百万 token）
# 未配置 Provider 时向量通道显式 unavailable，词法/精确/重排照常工作。
# 配对/版本/维度变化时旧向量整批作废，不会与新模型向量混用；批量补齐用
# POST /retrieval/vectors/backfill（Bearer 鉴权）。
# 可选神经 Reranker（Cohere/Jina 兼容 POST /rerank）；未配置时使用本地确定性重排：
# BLUEBIRD_RETRIEVAL_RERANKER_PROVIDER=http
# BLUEBIRD_RETRIEVAL_RERANKER_BASE_URL=http://127.0.0.1:8080/v1
# BLUEBIRD_RETRIEVAL_RERANKER_MODEL=your-reranker-model
# BLUEBIRD_RETRIEVAL_RERANKER_VERSION=v1
# BLUEBIRD_RETRIEVAL_RERANKER_API_KEY=
# BLUEBIRD_RETRIEVAL_RERANKER_TIMEOUT_MS=8000
# BLUEBIRD_RETRIEVAL_RERANKER_TOP_N=20
# 重排与时效（默认开启；纯本地计算，不调用外部服务）：
# BLUEBIRD_RETRIEVAL_RERANK=1
# BLUEBIRD_RETRIEVAL_RECENCY_HALF_LIFE_DAYS=30
# BLUEBIRD_RETRIEVAL_GRAPH_MIN_OVERLAP=2
# BLUEBIRD_RETRIEVAL_MAX_AGE_DAYS=0

# 可观测性（可选，默认开启；精确值 0 关闭）
# 关闭后业务照常运行，但监控 API/控制台显示 disabled，不显示健康。
# 存储上限、保留期、告警窗口见 docs/observability.md。
BLUEBIRD_MONITORING=1
